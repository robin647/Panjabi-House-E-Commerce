# Production env reference. Configure actual secret values in Render, never here.
DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=generate-a-unique-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=panjabi-house-e-commerce.onrender.com
ADMIN_URL=admin/
FRONTEND_URL=https://panjabi-house-e-commerce-1.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@RENDER_POSTGRES_HOST:5432/DATABASE
DB_CONN_MAX_AGE=60
CORS_ALLOWED_ORIGINS=https://panjabi-house-e-commerce-1.onrender.com
CSRF_TRUSTED_ORIGINS=https://panjabi-house-e-commerce-1.onrender.com
CORS_ALLOW_CREDENTIALS=False
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Shop <no-reply@example.com>
MEDIA_ROOT=/app/media
SERVE_MEDIA=True
SECURE_SSL_REDIRECT=True