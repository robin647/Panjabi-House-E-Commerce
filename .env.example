# Copy this file to .env and fill in real values. Never commit .env.

# --- Core ---
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
ADMIN_URL=admin/
FRONTEND_URL=http://localhost:5173

# --- Database (either DATABASE_URL, or the DB_* fields below) ---
DATABASE_URL=
DB_NAME=own_ecommerce_db
DB_USER=shop
DB_PASSWORD=local-dev-only-change-me
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- CORS / CSRF (comma-separated, full origins incl. scheme) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Brute-force protection ---
AXES_ENABLED=True
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_MINUTES=15

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Shop <no-reply@example.com>

# --- Payment gateways (filled in Phase 6) ---
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# --- SMS (filled in Phase 9) ---
SMS_API_KEY=
SMS_SENDER_ID=

# Production Render media uses a persistent disk mounted at /app/media.
# For an external S3 provider, configure its credentials in the platform and
# implement/cut over storage only after migrating existing media files.

# --- Shop ---
DELIVERY_CHARGE_INSIDE_DHAKA=60
DELIVERY_CHARGE_OUTSIDE_DHAKA=120

# --- Misc ---
LOG_LEVEL=INFO
API_DOCS_PUBLIC=True
SECURE_SSL_REDIRECT=False

# --- Frontend build (read by `npm run build`, not by Django) ---
# VITE_SHOP_NAME=Panjabi House
